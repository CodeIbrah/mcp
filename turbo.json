{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "start": {
      "dependsOn": ["typecheck"],
      "outputs": []
    },
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^typecheck"]
    }
  }
}
