# dev-mcp Environment Variables
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (required)
# Create at: https://github.com/settings/tokens
# Permissions needed: repo (read-only), public_repo
GITHUB_TOKEN=ghp_your_token_here

# Context7 API Key (optional — enables documentation search)
# Get at: https://context7.com
CONTEXT7_API_KEY=

# Exa API Key (optional — enables web search & research)
# Get at: https://exa.ai
EXA_API_KEY=

# Sentry DSN (optional — enables error reporting)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Runtime configuration
LOG_LEVEL=info              # debug | info | warn | error
NODE_ENV=development        # development | production | test

# HTTP server (mcp-server only)
HOST=0.0.0.0                # Listen address
PORT=3001                   # Listen port (1-65535)
CORS_ORIGIN=*               # Access-Control-Allow-Origin header value
